# Development Environment Configuration

# =============================================================================
# Database Configuration (PostgreSQL for development)
# =============================================================================

# PostgreSQL Connection
# Use 'postgres' as host when running in Docker, 'localhost' when running locally
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=alguerisme
DATABASE_PASSWORD=alguerisme_dev
DATABASE_NAME=alguerisme_dev
DATABASE_ECHO=false

# PostgreSQL Docker Environment (for postgres service)
POSTGRES_USER=alguerisme
POSTGRES_PASSWORD=alguerisme_dev
POSTGRES_DB=alguerisme_dev
