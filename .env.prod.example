# Production Environment Configuration Template
# Copy this to .env.prod and fill in your actual values

# =============================================================================
# Database Configuration (PostgreSQL for production)
# =============================================================================

# PostgreSQL Connection
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=alguerisme
DATABASE_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DATABASE_NAME=alguerisme_prod
DATABASE_ECHO=false

# PostgreSQL Docker Environment (for postgres service)
POSTGRES_USER=alguerisme
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=alguerisme_prod
