# Production Environment Configuration Template
# Copy this to .env.prod and fill in your actual values

# =============================================================================
# Database Configuration
# =============================================================================

# Database password should be securely set in secrets/prod/db_password.txt
# In Docker, the hostname is the service name 'postgres'
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=alguerisme
DATABASE_NAME=alguerisme_prod
DATABASE_ECHO=false


# =============================================================================
# Celery / Redis Configuration
# =============================================================================

# Redis password should be securely set in secrets/prod/redis_password.txt
# In Docker, the hostname is the service name 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
